APP_NAME="Zanini Renovations"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Ontario Eastern Time (EST / EDT automatically). Used for history timestamps,
# sent_at, updated_at, and all Carbon::now() values.
APP_TIMEZONE=America/Toronto

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=zanini_renovations
DB_USERNAME=root
DB_PASSWORD=

# Gmail SMTP (use a Google App Password, not your normal password)
# https://myaccount.google.com/apppasswords
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=zaninirenovations@gmail.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=zaninirenovations@gmail.com
MAIL_FROM_NAME="Zanini Renovations"
# Where contact form submissions are delivered (often same as MAIL_FROM_ADDRESS)
MAIL_CONTACT_TO=zaninirenovations@gmail.com

# Mocean SMS — day-before commencement text goes to each project's client_phone
# MOCEAN_API_TOKEN=apit-your-token-here
# MOCEAN_FROM=MOCEAN

SOCIAL_FACEBOOK_URL=https://www.facebook.com/zaninirenovations
SOCIAL_INSTAGRAM_URL=https://www.instagram.com/zaninirenovations/
SOCIAL_WHATSAPP_URL=https://wa.me/message/EZQPOEG772SDC1

# Optional SEO (leave blank to omit tags/snippets)
SEO_GOOGLE_SITE_VERIFICATION=
SEO_GA4_MEASUREMENT_ID=
# Path under /public for default Open Graph image, e.g. images/home_1_slider_1.webp
SEO_OG_IMAGE=images/home_1_slider_1.webp
# Google Business Profile URL (JSON-LD sameAs; optional override)
SEO_GOOGLE_BUSINESS_URL=

# Google Photos Picker (admin import) — create OAuth client in Google Cloud Console
# Enable Google Photos Picker API and add this OAuth scope in consent screen Data Access:
#   https://www.googleapis.com/auth/photospicker.mediaitems.readonly
GOOGLE_PHOTOS_CLIENT_ID=
GOOGLE_PHOTOS_CLIENT_SECRET=
# Optional override; default is APP_URL + /admin/google-photos/callback
GOOGLE_PHOTOS_REDIRECT_URI=
# Recommended: lock imports to your personal Google account email
GOOGLE_PHOTOS_ALLOWED_EMAIL=jonaszanini@gmail.com

# Google Maps Platform — use TWO keys once GOOGLE_MAPS_API_KEY uses HTTP referrer restrictions:
# Browser (Places autocomplete in admin): Maps JavaScript API + Places API (New), referrer = https://your-domain.ca/*
GOOGLE_MAPS_API_KEY=
# Server (travel estimates-Distance Matrix from PHP): same GCP project, NEW credential —
# Application restriction → IP addresses (Hostinger egress IP); API restriction → Distance Matrix API only.
# If you still use one unrestricted key for everything, duplicate it here until you split keys.
GOOGLE_MAPS_SERVER_API_KEY=
# GOOGLE_MAPS_DISTANCE_CACHE_TTL=86400

# Google Gemini (contract AI draft and future admin AI features)
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image-preview
# GEMINI_INLINE_IMAGE_MAX_BYTES=7340032
# GEMINI_TIMEOUT_SECONDS=120
# GEMINI_IMAGE_TIMEOUT_SECONDS=180

# Material price sync (local PC only — php artisan materials:sync-prices)
# Home Depot CA: store ID for correct shelf prices (Carleton Place = 7263).
# With a store ID, sync uses the fast FBT API and skips page scraping.
# MATERIALS_SCRAPER_HD_STORE_ID=7263
# MATERIALS_SCRAPER_FETCHER=http
# MATERIALS_SCRAPER_TIMEOUT=30
# MATERIALS_SCRAPER_API_TIMEOUT=5
# MATERIALS_SCRAPER_API_RETRIES=3
# MATERIALS_SCRAPER_API_RETRY_DELAY_MS=100
# MATERIALS_SCRAPER_FETCHER=browsershot
# MATERIALS_SCRAPER_DELAY_AFTER_LOAD_MS=5000
# MATERIALS_SCRAPER_DELAY_MS=1500
# OLLAMA_ENABLED=true
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen3:14b

# GST/HST registration (CRA format, shown on invoice PDFs)
# GST_HST_REGISTRATION_NUMBER=709216154RT0001

# Latest Projects Photos (portfolio) — higher quality than other WebP uploads
# WEBP_PORTFOLIO_QUALITY=85
# WEBP_PORTFOLIO_MAX_EDGE=1920
# WEBP_PORTFOLIO_MAX_BYTES=280000
