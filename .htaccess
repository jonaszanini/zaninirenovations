<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block phpinfo/debug scripts (security) - applies before rewrite to /public/
    RewriteRule ^(?:public/)?(test|info|phpinfo)\.php$ - [R=404,L]

    # One visible URL: https://zaninirenovations.ca/...
    # www and any visitor-facing /public/... address 301 there first.
    # THE_REQUEST is the browser's original line, so the internal rewrite below does not loop.
    RewriteCond %{HTTP_HOST} ^www\.zaninirenovations\.ca$ [NC,OR]
    RewriteCond %{THE_REQUEST} \s/+public(?:/|\s|\?) [NC]
    RewriteCond %{HTTP_HOST} ^(www\.)?zaninirenovations\.ca$ [NC]
    RewriteRule ^(?:public/?)?(.*)$ https://zaninirenovations.ca/$1 [L,R=301]

    # Serve Laravel from public/ without changing the browser address.
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ /public/$1 [L]
</IfModule>

# Prevent directory listing
Options -Indexes
